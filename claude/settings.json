{
  "permissions": {
    "allow": ["Bash(bundle exec:*)", "Bash(git add:*)", "Bash(git commit:*)"],
    "defaultMode": "auto"
  },
  "model": "claude-opus-5-5",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "mise env -s zsh >> \"$CLAUDE_ENV_FILE\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/notify.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "pr-tools@fin-2x": true,
    "code-review-tools@fin-2x": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowUnixSockets": ["~/.colima/default/docker.sock"],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": ["~/dev/.worktrees", "~/go", "~/.cache", "~/Library/Caches"]
    },
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": ["bundle *", "git *", "gh *", "docker *"]
  },
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim",
  "preferredNotifChannel": "kitty",
  "autoCompactEnabled": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "outputStyle": "concrete"
}
